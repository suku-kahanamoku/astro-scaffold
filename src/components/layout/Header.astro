---
import { site } from "../../config/site";
import { dictionary, locales, url, type Locale, type PageId } from "../../i18n";
interface Props {
  locale: Locale;
  page?: PageId;
}
const { locale, page = "home" } = Astro.props;
const t = dictionary(locale);
---

<header class="site-header">
  <a class="brand" href={url(locale)} aria-label={site.name}>
    <span class="brand-mark" aria-hidden="true">
      s.
    </span>
    {site.name}
    <span class="brand-dot">®</span>
  </a>
  <nav class="desktop-nav" aria-label={t.nav.menu}>
    <a
      class:list={["nav-link", { active: page === "home" }]}
      href={url(locale)}
      aria-current={page === "home" ? "page" : undefined}
    >
      {t.nav.home}
    </a>
    <a
      class:list={["nav-link", { active: page === "about" }]}
      href={url(locale, "about")}
      aria-current={page === "about" ? "page" : undefined}
    >
      {t.nav.about}
    </a>
  </nav>
  <div class="header-actions">
    <nav class="language-nav" aria-label={t.nav.language}>
      {locales.map((code) => (
        <a
          href={url(code, page)}
          lang={code}
          hreflang={code}
          aria-current={code === locale ? "true" : undefined}
        >
          {code.toUpperCase()}
        </a>
      ))}
    </nav>
    {site.modules.auth && (
      <a
        class="btn btn-sm btn-outline login-link"
        href={url(locale, "account")}
      >
        {t.nav.account}
        <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>
  <details class="mobile-menu">
    <summary class="btn btn-sm btn-ghost">
      {t.nav.menu} <span aria-hidden="true">☰</span>
    </summary>
    <nav class="mobile-menu-panel" aria-label={t.nav.menu}>
      <a href={url(locale)}>{t.nav.home}</a>
      <a href={url(locale, "about")}>{t.nav.about}</a>
      {site.modules.auth && (
        <a href={url(locale, "account")}>{t.nav.account}</a>
      )}
    </nav>
  </details>
</header>
