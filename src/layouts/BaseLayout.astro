---
import ThemeInit from "../modules/UIModule/components/ThemeInit.astro";
import SeoHead from "../modules/SiteModule/components/SeoHead.astro";
import "../styles/global.css";
import AdFrame from "../modules/AdsModule/components/AdFrame.astro";
import Header from "../modules/SiteModule/components/Header.astro";
import Footer from "../modules/SiteModule/components/Footer.astro";
import { dictionary } from "../modules/SiteModule/providers/translations";
import { type Locale } from "../modules/LangModule/providers/locale";
import { type PageId } from "../config/routes";
import { site } from "../config/site";

/**
 * Společný dokument stránky: hlavička `<head>` se SEO a motivem, přeskakovací odkaz
 * na obsah a rám s hlavičkou webu, obsahem a patičkou.
 * Reklama se vykreslí podle přepínačů v `src/config/site.ts`.
 */
interface Props {
  /** Jazyk dokumentu, propisuje se do `lang` a volí slovníky. */
  locale: Locale;
  /** Aktuální routa; určuje kanonickou URL a `hreflang` záznamy. */
  page?: PageId;
  /** Titulek stránky, v hlavičce doplněný názvem webu. */
  title: string;
  /** Popisek stránky pro SEO a sociální sítě. */
  description: string;
  /** `true` nastaví `noindex, nofollow`; používá se pro přihlášení a chyby. */
  noindex?: boolean;
}
const { locale, page, title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang={locale} data-theme={site.theme.name}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={site.theme.color} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SeoHead {locale} {page} {title} {description} {noindex} />
    <slot name="head" />
    <ThemeInit />
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      {dictionary(locale).common.skip}
    </a>
    <AdFrame {locale}>
      <Header {locale} {page} />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <Footer {locale} />
    </AdFrame>
  </body>
</html>
