---
import "../styles/components.css";
import { ads, type AdPosition } from "../../../config/ads";
import { dictionary } from "../providers/translations";
import { type Locale } from "../../LangModule/providers/locale";

/**
 * Rezerva pro jednu reklamní jednotku.
 * Definice slotu se vkládá do `data-ad-unit` jako JSON a reklamní skript
 * ji načte až ve chvíli, kdy je slot viditelný a existuje souhlas CMP.
 * Dokud se reklamu nevykreslí, je viditelný neutrální zástupný text.
 */
interface Props {
  /** Pozice slotu, určuje třídu i klíč v `src/config/ads.ts`. */
  position: AdPosition;
  /** Jazyk popisku slotu. */
  locale: Locale;
}
const { position, locale } = Astro.props;
const t = dictionary(locale);
---

<aside class:list={["ad-slot", `ad-${position}`]} aria-label={t.ad}>
  <span class="ad-label">{t.ad}</span>
  <div
    id={`ad-${position}`}
    class="ad-content"
    data-ad-unit={JSON.stringify(ads[position])}
  >
    <span class="ad-placeholder">{t.adSpace}</span>
  </div>
</aside>
