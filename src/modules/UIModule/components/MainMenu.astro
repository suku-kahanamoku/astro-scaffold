---
import "../styles/main-menu.css";
import ThemeToggle from "./ThemeToggle.astro";
import NavigationLinks from "./NavigationLinks.astro";
import type { NavigationItem } from "../types";

/**
 * Rám hlavičky webu: značka, vodorovná navigace, předvolby (motiv a jazyk),
 * volitelná hlavní akce a tlačítko pro mobilní menu.
 *
 * Ovládání přebírá `useMainMenu`, který se po každém `astro:page-load`
 * znovu naváže. Bez JavaScriptu zůstává mobilní panel viditelný díky
 * stylům v `noscript`.
 */
interface Props {
  /** Jazyk předávaný přepínači motivu. */
  locale: string;
  /** Popisek navigace, použije se jako `aria-label` a výchozí text tlačítka. */
  label: string;
  /** Položky vodorovného menu. */
  items: NavigationItem[];
  /** Položky mobilního menu, výchozí hodnotou je `items`. */
  mobileItems?: NavigationItem[];
  /** `id` panelu mobilního menu, na který odkazuje `aria-controls`. */
  menuId?: string;
  /** Text tlačítka ve stavu zavřeno, výchozí hodnotou je `label`. */
  openLabel?: string;
  /** Text tlačítka ve stavu otevřeno, výchozí hodnotou je `label`. */
  closeLabel?: string;
  /** `true` přidá třídu `main-menu-framed` pro zapadnutí do rámu s reklamou. */
  framed?: boolean;
  /** `true` vykreslí slot `action` vedle předvolb. */
  showAction?: boolean;
}
const {
  locale,
  label,
  items,
  mobileItems = items,
  menuId = "mobile-navigation",
  openLabel = label,
  closeLabel = label,
  framed = false,
  showAction = true,
} = Astro.props;
---

<header
  class:list={["main-menu", "site-header", { "main-menu-framed": framed }]}
  data-main-menu
>
  <div class="header-inner">
    <div class="header-brand">
      <slot name="brand" />
    </div>
    <nav class="desktop-nav" aria-label={label}>
      <NavigationLinks {items} class="nav-link" />
    </nav>
    <div class="header-actions">
      <div class="header-preferences">
        <ThemeToggle {locale} />
        <slot name="language" />
      </div>
      {showAction && Astro.slots.has("action") && (
        <div class="header-primary-action">
          <slot name="action" />
        </div>
      )}
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls={menuId}
        aria-label={openLabel}
        data-open-label={openLabel}
        data-close-label={closeLabel}
        data-menu-toggle
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <nav id={menuId} class="mobile-nav" aria-label={label} hidden>
    <NavigationLinks items={mobileItems} class="nav-link" />
  </nav>
</header>
<script>
  import { useMainMenu } from "../hooks/useMainMenu";
  useMainMenu();
  document.addEventListener("astro:page-load", useMainMenu);
</script>
<noscript>
  <style is:global>
    @media (max-width: 1279px) {
      .main-menu .menu-toggle {
        display: none;
      }
      @layer base {
        /* Vrstvený preflight s !important je nutné přepsat ve stejné vrstvě. */
        .main-menu .mobile-nav[hidden] {
          display: flex !important;
        }
      }
      .main-menu .mobile-nav[hidden] {
        display: flex !important;
        position: static;
        max-height: none;
        grid-column: 1 / -1;
      }
      .main-menu {
        position: relative;
      }
    }
  </style>
</noscript>
