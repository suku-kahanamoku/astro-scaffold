---
import { ads, type AdPosition } from "../../config/ads";
import { dictionary, type Locale } from "../../i18n";
interface Props {
  position: AdPosition;
  locale: Locale;
}
const { position, locale } = Astro.props;
const t = dictionary(locale);
---

<aside class:list={["ad-slot", `ad-${position}`]} aria-label={t.common.ad}>
  <span class="ad-label">{t.common.ad}</span>
  <div
    id={`ad-${position}`}
    class="ad-content"
    data-ad-unit={JSON.stringify(ads[position])}
  >
    <span class="ad-placeholder">{t.common.adSpace}</span>
  </div>
</aside>
