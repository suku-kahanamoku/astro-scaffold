---
import { dictionary, type Locale } from "../../i18n";
import { site } from "../../config/site";
interface Props {
  locale: Locale;
}
const t = dictionary(Astro.props.locale);
---

<section class="content-section">
  <p class="eyebrow">{t.nav.about}</p>
  <h1>{t.about.title}</h1>
  <p class="lead">{t.about.description}</p>
  <p>{t.about.body}</p>
  <a class="btn btn-primary" href={`mailto:${site.email}`}>
    {t.about.contact}
    <span aria-hidden="true">↗</span>
  </a>
</section>
