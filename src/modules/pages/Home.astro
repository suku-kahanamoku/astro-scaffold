---
import { Image } from "astro:assets";
import hero from "../../assets/hero.svg";
import { dictionary, url, type Locale } from "../../i18n";
import { site } from "../../config/site";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dictionary(locale);
---

<section class="hero-section">
  <div class="hero-copy">
    <p class="eyebrow">
      <span class="status-dot" aria-hidden="true"></span>
      {t.home.eyebrow}
    </p>
    <h1>{t.home.title}</h1>
    <p class="hero-description">{t.home.description}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={url(locale, "about")}>
        {t.home.cta}
        <span aria-hidden="true">↗</span>
      </a>
      {site.modules.auth && (
        <a class="text-link" href={url(locale, "account")}>
          {t.home.secondary}
          <span aria-hidden="true">→</span>
        </a>
      )}
    </div>
    <div class="hero-index" aria-hidden="true">
      <span>01 — 03</span>
      <span class="index-line"></span>
      <span>↓</span>
    </div>
  </div>
  <div class="hero-art">
    <Image
      src={hero}
      alt={t.common.imageAlt}
      width={960}
      height={1000}
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>
<section class="features-section">
  <div class="section-heading">
    <h2>{t.home.section}</h2>
    <p>{t.home.intro}</p>
  </div>
  <div class="feature-grid">
    {t.home.cards.map((card, index) => (
      <article class="card feature-card">
        <span class="feature-number">0{index + 1}</span>
        <h3>{card.title}</h3>
        <p>{card.text}</p>
      </article>
    ))}
  </div>
</section>
