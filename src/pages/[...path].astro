---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../modules/ContentModule/components/HeroSection.astro";
import FeaturesSection from "../modules/ContentModule/components/FeaturesSection.astro";
import BrandStrip from "../modules/SiteModule/components/BrandStrip.astro";
import { dictionary as contentDictionary } from "../modules/ContentModule/providers/translations";
import { dictionary as authDictionary } from "../modules/AuthModule/providers/translations";
import About from "../modules/ContentModule/components/AboutSection.astro";
import Login from "../modules/AuthModule/components/Login.astro";
import Account from "../modules/AuthModule/components/Account.astro";
import ErrorPage from "../modules/SiteModule/components/ErrorSection.astro";
import { dictionary } from "../modules/SiteModule/providers/translations";
import { localeFromPath } from "../modules/LangModule/providers/locale";
import { resolveRoute, url } from "../config/routes";
import { site } from "../config/site";
import type { User } from "../modules/AuthModule/types";

// Jediná routa, která skládá všechny sekce webu: canonicalizované cesty z
// `config/routes` se překládají na komponenty, neznalá cesta dostane 404.
// Routy `login` a `account` jsou soukromé, proto se značí `privatePage`
// (žádná cache) a vyžadují relaci. Uživatel se načítá jen zde a vždy
// memoizovaně přes `locals.getUser()`; selhání php-core znamená 503.
const route = resolveRoute(Astro.url.pathname);
const locale = route?.locale ?? localeFromPath(Astro.url.pathname);
const page = route?.page;
const t = dictionary(locale);
const content = contentDictionary(locale);
const { auth } = authDictionary(locale);
let error: 404 | 503 | undefined;
let user: User | null = null;
if (!route || (!site.modules.auth && (page === "login" || page === "account")))
  error = 404;
if (!error && (page === "account" || page === "login")) {
  Astro.locals.privatePage = true;
  try {
    user = await Astro.locals.getUser();
  } catch {
    error = 503;
  }
  if (!error && page === "account" && !user)
    return Astro.redirect(url(locale, "login"), 302);
  if (!error && page === "login" && user)
    return Astro.redirect(url(locale, "account"), 302);
}
if (error) Astro.response.status = error;
const metadata = error
  ? {
      title: error === 404 ? t.errors.notFound : t.errors.unavailable,
      description:
        error === 404
          ? t.errors.notFoundDescription
          : t.errors.unavailableDescription,
    }
  : page === "home"
    ? content.home
    : page === "about"
      ? content.about
      : page === "account"
        ? { title: auth.account, description: auth.accountDescription }
        : auth;
---

<BaseLayout
  {locale}
  page={error ? undefined : page}
  title={metadata.title}
  description={metadata.description}
  noindex={!!error || page === "login" || page === "account"}
>
  {error ? (
    <ErrorPage {locale} status={error} />
  ) : page === "home" ? (
    <>
      <HeroSection {locale} />
      <BrandStrip {locale} />
      <FeaturesSection {locale} />
    </>
  ) : page === "about" ? (
    <About {locale} />
  ) : page === "account" && user ? (
    <Account {locale} {user} />
  ) : (
    <Login {locale} />
  )}
</BaseLayout>
